classDiagram
    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +get_all_tasks() list
    }
    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
    }
    class Task {
        +str description
        +datetime due
        +str frequency
        +bool completed
        +mark_complete()
    }
    class Scheduler {
        +Owner owner
        +sort_by_time() list
    }
    Owner "1" o-- "0..*" Pet : cares for
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : retrieves all tasks
